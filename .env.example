PORT=8080
AUTH_SECRET=change-me-in-production

# Local development: use redis:// scheme (required by redis.ParseURL)
# Upstash / Vercel deployment: use the full rediss:// TLS URL from your Upstash dashboard
# e.g. VAULT_ADDRESS=rediss://:<password>@<host>.upstash.io:6380
VAULT_ADDRESS=redis://localhost:6379

GRID_ORIGIN=http://localhost:5173
HANDSHAKE_TTL_SECONDS=60